# systemd 사용자 서비스 (재부팅 뒤 자동 시작용)
#   mkdir -p ~/.config/systemd/user && cp deploy/palmweb.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now palmweb
#   sudo loginctl enable-linger $USER     # 로그인하지 않아도 사용자 서비스가 돌게 (한 번만, 관리자 권한)
[Unit]
Description=palmweb (손금 웹 체험 서버)
After=network-online.target

[Service]
WorkingDirectory=%h/palmistry-art/palmweb
Environment=PALMWEB_WORKERS=4
Environment=LD_LIBRARY_PATH=%h/palmistry-art/syslib/root/usr/lib/x86_64-linux-gnu
ExecStart=%h/palmistry-art/palmweb/.venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
